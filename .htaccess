# ===========================================
# WAREHOUSE MANAGEMENT SECURITY CONFIGURATION
# ===========================================

# ============================================
# 1. DISABLE DIRECTORY BROWSING
# ============================================
Options -Indexes

# ============================================
# 2. REMOVE .PHP EXTENSION FROM URL
# ============================================
# Enable URL rewriting
RewriteEngine On
RewriteBase /

# Remove .php extension from URL
# If the request is for a .php file, redirect to non-.php URL
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.*)$ $1.php [L]

# Redirect .php URLs to non-.php URLs
RewriteCond %{THE_REQUEST} ^GET\ /[^?\s]+\.php
RewriteRule ^(.*)\.php$ /$1 [R=301,L]

# ============================================
# 3. PROTECT SENSITIVE FILES
# ============================================
# Deny access to .htaccess and .htpasswd
<Files ~ "^\.ht">
    Order allow,deny
    Deny from all
</Files>

# Protect config files
<FilesMatch "\.(env|ini|log|sh|sql|bak|config)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Protect warehouse.sql and other SQL files in root
<Files "warehouse.sql">
    Order allow,deny
    Deny from all
</Files>

# Protect reset SQL files
<FilesMatch "reset.*\.sql$">
    Order allow,deny
    Deny from all
</FilesMatch>

# ============================================
# 4. SECURITY HEADERS
# ============================================
# Prevent clickjacking
Header always set X-Frame-Options "SAMEORIGIN"

# Prevent MIME type sniffing
Header always set X-Content-Type-Options "nosniff"

# Enable XSS protection
Header always set X-XSS-Protection "1; mode=block"

# Referrer policy
Header always set Referrer-Policy "strict-origin-when-cross-origin"

# ============================================
# 5. DISABLE PHP EXECUTION IN UPLOADS
# ============================================
# If you have an uploads or assets directory, prevent PHP execution
<Directory "assets">
    php_flag engine off
    RemoveHandler .php .phtml .php3 .php4 .php5 .phps
    RemoveType .php .phtml .php3 .php4 .php5 .phps
</Directory>

# ============================================
# 6. PROTECT INCLUDES DIRECTORY
# ============================================
# Allow only specific files from includes to be accessed
<FilesMatch "^(db|auth|functions)\.php$">
    Order allow,deny
    Deny from all
</FilesMatch>

# ============================================
# 7. BLOCK COMMON ATTACK PATTERNS
# ============================================
# Block SQL injection attempts
RewriteCond %{QUERY_STRING} (union|select|insert|cast|set|declare|drop|update|md5|benchmark) [NC]
RewriteRule ^(.*)$ - [F,L]

# Block XSS attempts
RewriteCond %{QUERY_STRING} (<script>|<iframe>|<object>|javascript:) [NC]
RewriteRule ^(.*)$ - [F,L]

# Block file inclusion attempts
RewriteCond %{QUERY_STRING} (\.\.\/|boot\.ini|etc/passwd|self/environ) [NC]
RewriteRule ^(.*)$ - [F,L]

# ============================================
# 8. DISABLE SERVER SIGNATURE
# ============================================
ServerSignature Off

# ============================================
# 9. FORCE HTTPS (OPTIONAL - UNCOMMENT IF USING SSL)
# ============================================
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ============================================
# 10. ERROR PAGES
# ============================================
# Custom error pages (optional - create these if needed)
# ErrorDocument 403 /error_403.php
# ErrorDocument 404 /error_404.php
# ErrorDocument 500 /error_500.php

# ============================================
# 11. PHP SETTINGS (OPTIONAL SECURITY)
# ============================================
# Disable dangerous PHP functions
php_flag display_errors Off
php_flag log_errors On
php_value error_log /tmp/php_errors.log

# Session security
php_flag session.cookie_httponly On
php_flag session.use_only_cookies On
php_value session.cookie_lifetime 0
