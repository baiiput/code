# ===========================================
# WAREHOUSE MANAGEMENT SECURITY
# Apache 2.2 Compatible Version
# ===========================================

# Enable URL rewriting
RewriteEngine On
RewriteBase /

# Allow direct access to reports directory and its files
RewriteCond %{REQUEST_URI} ^/reports/ [NC]
RewriteRule ^ - [L]

# Remove .php extension from URL
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.*)$ $1.php [L]

# Redirect .php URLs to non-.php URLs (skip for reports directory)
RewriteCond %{REQUEST_URI} !^/reports/ [NC]
RewriteCond %{THE_REQUEST} ^GET\ /[^?\s]+\.php
RewriteRule ^(.*)\.php$ /$1 [R=301,L]

# Protect .htaccess
<Files .htaccess>
    Order allow,deny
    Deny from all
</Files>

# Protect sensitive files
<FilesMatch "\.(env|ini|log|sh|sql|bak|config)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Protect warehouse.sql
<Files warehouse.sql>
    Order allow,deny
    Deny from all
</Files>

# Protect reset SQL files
<FilesMatch "reset.*\.sql$">
    Order allow,deny
    Deny from all
</FilesMatch>
