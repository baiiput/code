<script>
// Disabled editor with security notice
if(typeof(Storage) !== "undefined"){
    sessionStorage.setItem("MikhmonSession", document.getElementById("MikhmonSession") ? document.getElementById("MikhmonSession").innerHTML : "");
} else {
    alert("Please use Google Chrome");
}

var session = sessionStorage.getItem("MikhmonSession");
if(session === null || session === ""){
    console.log("Mikhmon session warning");
}

// Initialize CodeMirror in read-only mode
var editor = CodeMirror.fromTextArea(document.getElementById("editorMikhmon"), {
    lineNumbers: true,
    matchBrackets: true,
    mode: "application/x-httpd-php",
    indentUnit: 4,
    indentWithTabs: true,
    lineWrapping: true,
    viewportMargin: Infinity,
    readOnly: true, // Make editor read-only
    theme: "material",
    matchTags: {bothTags: true},
    extraKeys: {"Ctrl-J": "toMatchingTag"}
});

// Additional security: Disable all editing capabilities
editor.setOption("readOnly", "nocursor");
editor.setOption("cursorBlinkRate", -1);

// Show security notice
setTimeout(function() {
    if (confirm("PERHATIAN: Voucher Editor telah dinonaktifkan untuk keamanan sistem.\n\nKlik OK untuk melanjutkan melihat template dalam mode read-only.\nKlik Cancel untuk kembali ke halaman utama.")) {
        console.log("User acknowledged security notice");
    } else {
        window.history.back();
    }
}, 1000);

// Prevent any form submission
document.querySelector('form').addEventListener('submit', function(e) {
    e.preventDefault();
    alert('🔒 Editor dinonaktifkan! Hubungi administrator untuk bantuan.');
    return false;
});

// Disable right-click context menu on editor area
document.getElementById('editorMikhmon').addEventListener('contextmenu', function(e) {
    e.preventDefault();
    alert('🔒 Fitur edit dinonaktifkan untuk keamanan sistem.');
    return false;
});

// Disable copy/paste/cut operations
document.addEventListener('keydown', function(e) {
    // Disable Ctrl+A (Select All), Ctrl+C (Copy), Ctrl+V (Paste), Ctrl+X (Cut)
    if (e.ctrlKey && (e.keyCode === 65 || e.keyCode === 67 || e.keyCode === 86 || e.keyCode === 88)) {
        e.preventDefault();
        alert('🔒 Operasi copy/paste dinonaktifkan untuk keamanan.');
        return false;
    }
    // Disable F12 (Developer Tools)
    if (e.keyCode === 123) {
        e.preventDefault();
        alert('🔒 Developer tools dinonaktifkan pada halaman ini.');
        return false;
    }
    // Disable Ctrl+Shift+I (Inspect Element)
    if (e.ctrlKey && e.shiftKey && e.keyCode === 73) {
        e.preventDefault();
        alert('🔒 Inspect element dinonaktifkan untuk keamanan.');
        return false;
    }
    // Disable Ctrl+U (View Source)
    if (e.ctrlKey && e.keyCode === 85) {
        e.preventDefault();
        alert('🔒 View source dinonaktifkan untuk keamanan.');
        return false;
    }
});

// Disable text selection on sensitive areas
document.getElementById('editorMikhmon').style.userSelect = 'none';
document.getElementById('editorMikhmon').style.webkitUserSelect = 'none';
document.getElementById('editorMikhmon').style.mozUserSelect = 'none';
document.getElementById('editorMikhmon').style.msUserSelect = 'none';

document.getElementById('var').style.userSelect = 'none';
document.getElementById('var').style.webkitUserSelect = 'none';
document.getElementById('var').style.mozUserSelect = 'none';
document.getElementById('var').style.msUserSelect = 'none';

// Additional security message
console.clear();
console.log('%c🔒 SISTEM KEAMANAN AKTIF 🔒', 'color: red; font-size: 20px; font-weight: bold;');
console.log('%cAkses ke template voucher dibatasi untuk keamanan sistem.', 'color: orange; font-size: 14px;');
console.log('%cHubungi administrator jika membutuhkan bantuan.', 'color: orange; font-size: 14px;');
</script>