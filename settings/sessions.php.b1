                            $hotspotName = "Unknown";
                            if (isset($sessionData[4])) {
                                $hotspotData = $sessionData[4];
                                $parts = explode('%', $hotspotData);
                                if (count($parts) > 1) {
                                    $hotspotName = $parts[1];
                                } else {
                                    $hotspotName = $sessionName;
                                }
                            }
                        ?>
                        <div class="router-box <?= $colorClasses[array_rand($colorClasses)]; ?>">
