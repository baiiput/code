    <script>
        function Pass(id){
            var x = document.getElementById(id);
            var eye = document.getElementById(id + '-eye');
            if (x.type === 'password') {
                x.type = 'text';
                eye.className = 'fas fa-eye-slash';
            } else {
                x.type = 'password';
                eye.className = 'fas fa-eye';
            }
        }
    </script>
